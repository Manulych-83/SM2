; SM2: Godot 4.7.2, typed GDScript.
config_version=5

[application]
config/name="SM2"
config/version="0.8.38-camp.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="SM2"

[display]
window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=4
; Avoid Godot/Windows exclusive-fullscreen restore bug when initial window equals the monitor.
; Fullscreen and the design viewport remain 2560x1440; this only seeds the restore rectangle.
window/size/window_width_override=2559
window/size/window_height_override=1440
window/size/min_width=1000
window/size/min_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale=1.6
window/stretch/scale_mode="fractional"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.047, 0.061, 0.067, 1)

[debug]
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
