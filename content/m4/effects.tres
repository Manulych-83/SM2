[resource]
script = ExtResource("1")
effects = Array[Dictionary]([{"id": "m4:effect.poison", "name": "Отравление", "tags": ["status.poison"], "polarity": "harmful", "dispellable": true, "duration": 3, "clock": "target_activation_end", "stacking": "refresh", "operations": [{"kind": "periodic_hp_damage", "stat": "", "channel": "poison", "amount": 5}]}, {"id": "m4:effect.weakness", "name": "Ослабление", "tags": ["status.weakness"], "polarity": "harmful", "dispellable": true, "duration": 2, "clock": "target_activation_end", "stacking": "refresh", "operations": [{"kind": "flat_stat_modifier", "stat": "melee_skill", "channel": "", "amount": -10}, {"kind": "flat_stat_modifier", "stat": "ranged_skill", "channel": "", "amount": -10}]}, {"id": "m4:effect.cover", "name": "Прикрытие", "tags": ["status.cover"], "polarity": "helpful", "dispellable": true, "duration": 2, "clock": "target_activation_end", "stacking": "refresh", "operations": [{"kind": "flat_stat_modifier", "stat": "melee_defense", "channel": "", "amount": 10}, {"kind": "flat_stat_modifier", "stat": "ranged_defense", "channel": "", "amount": 10}]}])
actions = Array[Dictionary]([{"id": "m4:ability.poison", "name": "Отравление", "operation": "apply_effect", "effect_id": "m4:effect.poison", "target_side": "enemy", "ap_cost": 3, "fatigue_cost": 6, "range_min": 1, "range_max": 3}, {"id": "m4:ability.weakness", "name": "Ослабление", "operation": "apply_effect", "effect_id": "m4:effect.weakness", "target_side": "enemy", "ap_cost": 3, "fatigue_cost": 6, "range_min": 1, "range_max": 3}, {"id": "m4:ability.cover", "name": "Прикрытие", "operation": "apply_effect", "effect_id": "m4:effect.cover", "target_side": "ally", "ap_cost": 3, "fatigue_cost": 6, "range_min": 0, "range_max": 3}, {"id": "m4:ability.cleanse", "name": "Очищение", "operation": "dispel_effects", "effect_id": "", "target_side": "ally", "ap_cost": 3, "fatigue_cost": 6, "range_min": 0, "range_max": 3}])
profiles = Array[Dictionary]([{"id": "m2:loadout.spear_guard", "actions": ["m4:ability.poison", "m4:ability.weakness", "m4:ability.cover", "m4:ability.cleanse"], "immunities": ["status.poison"], "resistances": {"poison": 0}}, {"id": "m2:loadout.sword_fighter", "actions": ["m4:ability.poison", "m4:ability.weakness", "m4:ability.cover", "m4:ability.cleanse"], "immunities": [], "resistances": {"poison": 50}}, {"id": "m2:loadout.bow_archer", "actions": ["m4:ability.poison", "m4:ability.weakness", "m4:ability.cover", "m4:ability.cleanse"], "immunities": [], "resistances": {"poison": 0}}, {"id": "m2:loadout.axe_fighter", "actions": ["m4:ability.poison", "m4:ability.weakness", "m4:ability.cover", "m4:ability.cleanse"], "immunities": [], "resistances": {"poison": 0}}])
